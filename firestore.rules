rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function adminConfig() {
      return get(/databases/$(database)/documents/config/admins).data;
    }

    function adminConfigExists() {
      return exists(/databases/$(database)/documents/config/admins);
    }

    function isListedEmail(email) {
      return adminConfigExists()
        && (
          (adminConfig().keys().hasAny(['emails'])
            && adminConfig().emails is list
            && email in adminConfig().emails)
          || (adminConfig().keys().hasAny(['emails'])
            && adminConfig().emails is string
            && email == adminConfig().emails)
          || (adminConfig().keys().hasAny(['email'])
            && adminConfig().email is string
            && email == adminConfig().email)
        );
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email != null
        && isListedEmail(request.auth.token.email);
    }

    function isValidOptionalUrl(value) {
      return value is string && (value.size() == 0 || value.matches('^https://.+$'));
    }

    function isValidEventCreate() {
      return isAdmin()
        && request.resource.data.keys().hasOnly([
          'createdAt',
          'createdBy',
          'date',
          'lumaEventLink',
          'name',
          'typeformRegistrationUrl',
          'typeformSubmissionUrl'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.date is string
        && request.resource.data.date.size() > 0
        && request.resource.data.lumaEventLink is string
        && request.resource.data.lumaEventLink.matches('^https://.+$')
        && isValidOptionalUrl(request.resource.data.typeformRegistrationUrl)
        && isValidOptionalUrl(request.resource.data.typeformSubmissionUrl)
        && request.resource.data.createdBy == request.auth.token.email;
    }

    function isValidEventUpdate() {
      return isAdmin()
        && request.resource.data.keys().hasOnly([
          'createdAt',
          'createdBy',
          'date',
          'lumaEventLink',
          'name',
          'typeformRegistrationUrl',
          'typeformSubmissionUrl'
        ])
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.date is string
        && request.resource.data.date.size() > 0
        && request.resource.data.lumaEventLink is string
        && request.resource.data.lumaEventLink.matches('^https://.+$')
        && isValidOptionalUrl(request.resource.data.typeformRegistrationUrl)
        && isValidOptionalUrl(request.resource.data.typeformSubmissionUrl);
    }

    match /config/admins {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /events/{eventId} {
      allow read: if isAdmin();
      allow create: if isValidEventCreate();
      allow update: if isValidEventUpdate();
      allow delete: if false;

      match /datasets/{datasetId} {
        allow read, write: if isAdmin();

        match /rows/{rowId} {
          allow read, write: if isAdmin();
        }
      }
    }
  }
}
