rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAnonymousSignedIn() {
      return isSignedIn()
        && (
          request.auth.token.firebase.sign_in_provider == 'anonymous'
          || (request.auth.token.email == null && request.auth.token.firebase.sign_in_provider != 'google.com')
        );
    }

    function adminConfig() {
      return get(/databases/$(database)/documents/config/admins).data;
    }

    function adminConfigExists() {
      return exists(/databases/$(database)/documents/config/admins);
    }

    function isListedEmail(email) {
      return adminConfigExists()
        && (
          (adminConfig().keys().hasAny(['emails'])
            && adminConfig().emails is list
            && email in adminConfig().emails)
          || (adminConfig().keys().hasAny(['emails'])
            && adminConfig().emails is string
            && email == adminConfig().emails)
          || (adminConfig().keys().hasAny(['email'])
            && adminConfig().email is string
            && email == adminConfig().email)
        );
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email != null
        && isListedEmail(request.auth.token.email);
    }

    function canReadEventData() {
      return isAdmin() || isAnonymousSignedIn();
    }

    function isValidOptionalUrl(value) {
      return value is string && (value.size() == 0 || value.matches('^https://.+$'));
    }

    function isValidJudgeId(judgeId) {
      return judgeId is string
        && judgeId.matches('^j[0-9]+$');
    }

    function isLegacyJudgeDocId(judgeId) {
      return !(judgeId.matches('^j[0-9]+$'));
    }

    function isValidJudgeEvaluation() {
      return request.resource.data.keys().hasOnly(['judgeName', 'rating', 'notes', 'updatedAt'])
        && request.resource.data.judgeName is string
        && request.resource.data.judgeName.size() > 0
        && request.resource.data.judgeName.size() <= 80
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.notes is string
        && request.resource.data.notes.size() <= 2000
        && request.resource.data.updatedAt == request.time;
    }

    function isValidTeamEvaluationParent() {
      return request.resource.data.keys().hasOnly(['teamId'])
        && request.resource.data.teamId is string
        && request.resource.data.teamId.size() > 0;
    }

    function isValidEventCreate() {
      return isAdmin()
        && request.resource.data.keys().hasOnly([
          'createdAt',
          'createdBy',
          'date',
          'lumaEventLink',
          'name',
          'typeformRegistrationUrl',
          'typeformSubmissionUrl'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.date is string
        && request.resource.data.date.size() > 0
        && request.resource.data.lumaEventLink is string
        && request.resource.data.lumaEventLink.matches('^https://.+$')
        && isValidOptionalUrl(request.resource.data.typeformRegistrationUrl)
        && isValidOptionalUrl(request.resource.data.typeformSubmissionUrl)
        && request.resource.data.createdBy == request.auth.token.email;
    }

    function isValidEventUpdate() {
      return isAdmin()
        && request.resource.data.keys().hasOnly([
          'createdAt',
          'createdBy',
          'date',
          'lumaEventLink',
          'name',
          'typeformRegistrationUrl',
          'typeformSubmissionUrl'
        ])
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.date is string
        && request.resource.data.date.size() > 0
        && request.resource.data.lumaEventLink is string
        && request.resource.data.lumaEventLink.matches('^https://.+$')
        && isValidOptionalUrl(request.resource.data.typeformRegistrationUrl)
        && isValidOptionalUrl(request.resource.data.typeformSubmissionUrl);
    }

    match /config/admins {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /events/{eventId} {
      allow read: if canReadEventData();
      allow create: if isValidEventCreate();
      allow update: if isValidEventUpdate();
      allow delete: if false;

      match /datasets/{datasetId} {
        allow read: if canReadEventData();
        allow write: if isAdmin();

        match /rows/{rowId} {
          allow read: if canReadEventData();
          allow write: if isAdmin();
        }
      }

      match /evaluations/{teamId} {
        allow read: if canReadEventData();
        allow create, update: if isAnonymousSignedIn() && isValidTeamEvaluationParent();
        allow delete: if isAdmin();

        match /judges/{judgeId} {
          allow read: if canReadEventData();
          allow create, update: if isAnonymousSignedIn()
            && isValidJudgeId(judgeId)
            && isValidJudgeEvaluation();
          allow delete: if isAdmin()
            || (isAnonymousSignedIn() && isLegacyJudgeDocId(judgeId));
        }
      }
    }
  }
}
